<% if record.errors.any? %>
  <div role="alert" class="rounded-md border border-danger-line bg-danger-bg px-4 py-3 text-sm text-danger">
    <p class="font-medium"><%= pluralize(record.errors.count, "error") %> stopped this from saving:</p>
    <ul class="mt-1.5 list-disc space-y-0.5 pl-5">
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
