<%# The signed-in user at the bottom of the sidenav; clicking it opens a menu above it %>
<div data-controller="user-menu" data-action="click@window->user-menu#closeOnClickOutside keydown.esc->user-menu#closeWithEscape" class="relative mt-auto pt-4 text-sm">
  <div id="user_menu" data-user-menu-target="menu" class="absolute inset-x-0 bottom-full z-10 mb-1 hidden rounded-md border border-line bg-card p-1 shadow-card">
    <%= link_to account_settings_path, class: "flex items-center gap-3 rounded-md px-3 py-2 text-ink hover:bg-hover" do %>
      <%= render "icons/settings" %>
      Account settings
    <% end %>
    <%= button_to sign_out_path, method: :delete, class: "flex w-full cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-ink hover:bg-hover" do %>
      <%= render "icons/sign_out" %>
      Sign out
    <% end %>
  </div>

  <button type="button" data-user-menu-target="button" data-action="user-menu#toggle" aria-controls="user_menu" aria-expanded="false" class="flex w-full cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-left text-ink hover:bg-hover">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-active">
      <%= render "icons/user" %>
    </span>
    <span class="truncate font-medium"><%= Current.user.display_name %></span>
  </button>
</div>
