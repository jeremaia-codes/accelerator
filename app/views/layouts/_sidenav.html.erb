<%# Dimmed overlay behind the open sidenav on mobile; clicking it closes the menu %>
<div data-sidenav-target="backdrop" data-action="click->sidenav#close" class="fixed inset-0 z-10 hidden bg-overlay md:hidden"></div>

<%# Sidenav: a drawer over the page on mobile (opened by the sidenav controller), an always-visible sticky sidebar from md up %>
<aside id="sidenav" data-sidenav-target="menu" class="fixed inset-y-0 left-0 z-20 hidden h-dvh w-64 overflow-y-auto shrink-0 border-r border-line bg-canvas px-3 pb-4 md:sticky md:top-0 md:block">
  <div class="flex h-header items-center justify-between px-3">
    <%= link_to account_path do %>
      <%= image_tag "/icon.svg", alt: "Accelerator", class: "h-8 w-8" %>
    <% end %>
    <button type="button" data-sidenav-target="closeButton" data-action="sidenav#close" aria-label="Close menu" class="-mr-3 flex h-10 w-10 items-center justify-center rounded-md text-ink hover:bg-hover md:hidden">
      <%= render "icons/close" %>
    </button>
  </div>

  <nav aria-label="Main" class="text-sm">
    <%= link_to account_path, aria: { current: (current_page?(account_path) ? "page" : nil) }, class: "flex items-center gap-3 rounded-md px-3 py-2 text-ink hover:bg-hover aria-[current=page]:bg-active" do %>
      <%= render "icons/user" %>
      Account
    <% end %>
  </nav>
</aside>
