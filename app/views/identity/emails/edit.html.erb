<% content_for :title, "Email" %>

<h1 class="mb-6 text-2xl/9 font-medium text-ink">Email</h1>

<% unless Current.user.verified? %>
  <div class="mb-4 flex flex-col gap-3 rounded-xl border border-banner-line bg-banner px-5 py-3.5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3 text-sm text-banner-ink">
      <%= render "icons/mail" %>
      We sent you a link to verify your email address.
    </div>
    <%= button_to "Resend email", identity_email_verification_path, class: "shrink-0 cursor-pointer rounded-md border border-banner-line bg-card px-3.5 py-1.5 text-sm text-banner-ink shadow-card transition-colors hover:bg-hover" %>
  </div>
<% end %>

<%= render layout: "shared/card", locals: {
  title: "Change email",
  description: "You're signed in as #{Current.user.email}."
} do %>
  <%= form_with(url: identity_email_path, method: :patch, class: "max-w-sm space-y-5") do |form| %>
    <div>
      <%= form.label :email, "New email", class: "form-label" %>
      <%= form.email_field :email, required: true, autocomplete: "email", aria: field_error_aria(@user, :email), class: "form-input" %>
      <%= field_error @user, :email %>
    </div>

    <div>
      <%= form.label :password_challenge, "Current password", class: "form-label" %>
      <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", aria: field_error_aria(@user, :password_challenge), class: "form-input" %>
      <%= field_error @user, :password_challenge %>
    </div>

    <%= form.submit "Save changes", class: "btn-primary w-auto" %>
  <% end %>
<% end %>
