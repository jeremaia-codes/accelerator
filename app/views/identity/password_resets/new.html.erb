<% content_for :title, "Forgot your password?" %>

<% footer = capture do %>
  <p>Remembered it? <%= link_to "Back to sign in", sign_in_path, class: "link" %></p>
<% end %>

<%= render layout: "shared/auth_card", locals: {
  title: "Forgot your password?",
  subtitle: "We'll email you a link to reset it.",
  footer: footer
} do %>
  <%= form_with(url: identity_password_reset_path, class: "space-y-5") do |form| %>
    <div>
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "form-input" %>
    </div>

    <%= form.submit "Send password reset email", class: "btn-primary" %>
  <% end %>
<% end %>
