<% content_for :title, "Reset your password" %>

<%= render layout: "shared/auth_card", locals: {
  title: "Reset your password",
  subtitle: "Choose a new password for your account."
} do %>
  <%= form_with(url: identity_password_reset_path, method: :patch, class: "space-y-5") do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <%= form.hidden_field :sid, value: params[:sid] %>

    <div>
      <%= form.label :password, "New password", class: "form-label" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: "form-input" %>
      <p class="form-hint">12 characters minimum.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input" %>
    </div>

    <%= form.submit "Save changes", class: "btn-primary" %>
  <% end %>
<% end %>
